# Copy to .env.local and adjust as needed.

# SUTU backend API key (sent as X-API-Key on every request).
# Default fallback in code: sutu-dev-key
NEXT_PUBLIC_SUTU_API_KEY=sutu-dev-key

# Backend origin the /api/v1 and /health rewrites proxy to.
# Default fallback in code: https://sutu.rynaqrtz.my.id
# `sutu.tixrouter.my.id` is retired and no longer answers — do not use it.
NEXT_PUBLIC_SUTU_API_ORIGIN=https://sutu.rynaqrtz.my.id
